# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets

APP_PASSCODE   = "choose-a-strong-passcode"
GEMINI_API_KEY = "your-gemini-api-key"

# Optional: Supabase (Postgres) for history that survives redeploys.
# Leave both blank to fall back to a local SQLite file.
# SUPABASE_KEY must be the service_role key — it is used server-side only and never
# reaches the browser. Keep Row Level Security ON so no one else can read the table.
SUPABASE_URL = ""
SUPABASE_KEY = ""
